{
  "name": "elmsford",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @elmsford/server --filter @elmsford/web dev",
    "build": "pnpm --filter @elmsford/web build",
    "start": "pnpm --filter @elmsford/server start",
    "start:lan": "ELMSFORD_LAN=1 pnpm --filter @elmsford/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @elmsford/server db:generate",
    "reset": "rm -rf data",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
