    "@hono/node-server": "^2.1.5",
    "@elmsford/content": "workspace:*",
    "@elmsford/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "openai": "^7.38.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  }
